# Copy to .env.local for local dev (already gitignored via .env*.local).
# EXPO_PUBLIC_* is inlined at build time — same convention as
# fleetly-admin's NEXT_PUBLIC_*. Only reachable from `expo start --web`
# on this machine as-is; a real phone's "localhost" is the phone
# itself, so device testing needs this machine's real LAN IP instead.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SUPABASE_AUTH_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
